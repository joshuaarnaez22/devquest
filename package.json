{
  "name": "devquest",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:pillars": "echo 'not implemented \u2014 lands in M2'",
    "level:test": "VITE_LEVEL_TEST=1 vite --open",
    "level:validate": "echo 'not implemented \u2014 lands in M4'",
    "assets:build": "node tools/atlas/build-atlas.mjs",
    "assets:verify": "node tools/atlas/check-budget.mjs && node tools/atlas/check-density.mjs && node tools/atlas/check-palette.mjs",
    "docs:check": "node tools/docs/check-constants.mjs && node tools/docs/check-template.mjs",
    "ci:boundaries": "madge --circular --extensions ts src/",
    "ci:portability": "node tools/ci/check-portability.mjs",
    "ci:scenes": "node tools/ci/check-scenes.mjs",
    "ci:size": "node tools/ci/check-size.mjs",
    "ci:schema": "echo 'schema stub \u2014 no content yet'",
    "ci:migrations": "echo 'migrations stub \u2014 no content yet'",
    "spell": "cspell \"src/**/*.{ts,md}\" \"tools/**/*.{mjs,md}\" \"README.md\" \"CLAUDE.md\" --no-progress",
    "ci:spell": "npm run spell",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "free-tex-packer-core": "^0.3.9",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
